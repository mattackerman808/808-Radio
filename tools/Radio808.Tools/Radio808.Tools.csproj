<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows: WinForms for the icon tool and WASAPI audio; elsewhere (macOS): plain net9.0 with miniaudio -->
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net9.0-windows</TargetFramework>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net9.0</TargetFramework>
    <UseWindowsForms Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>radio808-tools</AssemblyName>
  </PropertyGroup>

  <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <Compile Remove="IconTool.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Radio808.Core\Radio808.Core.csproj" />
    <!-- WAV reading and writing for the offline tools (cross-platform) -->
    <PackageReference Include="NAudio.Core" Version="3.1.0" />
  </ItemGroup>

</Project>
