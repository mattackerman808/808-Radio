<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>808Radio</AssemblyName>
    <RootNamespace>Radio808.App</RootNamespace>
    <Product>808 Radio</Product>
    <Version>0.1.0</Version>
    <Copyright>GPL-3.0-or-later</Copyright>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- release builds: self-contained for win-x64 (no .NET install needed) -->
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Release'">win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="app.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Radio808.Core\Radio808.Core.csproj" />
  </ItemGroup>

</Project>
